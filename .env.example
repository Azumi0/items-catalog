# Skopiuj do .env i podmien wartosc:  cp .env.example .env
# Wygeneruj sekret:                   openssl rand -hex 32
# PowerShell:                         -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
#
# Minimum 32 znaki (wymog iron-session). Zmiana uniewaznia wszystkie sesje.
SESSION_SECRET=

# --- Generowanie opisow przedmiotow przez AI (opcjonalne) ---
#
# Bez klucza funkcja jest wylaczona: przycisk "Wygeneruj opis z AI" w ogole
# sie nie renderuje, reszta katalogu dziala bez zmian.
#
# Klucz zakladasz w Google AI Studio: https://aistudio.google.com/apikey
# Czytany wylacznie po stronie serwera. Nigdy nie trafia do przegladarki.
#
# UWAGA: wlaczenie tej funkcji oznacza, ze zdjecie glowne przedmiotu jest
# wysylane do Google. Patrz docs/adr/ADR-008-wysylka-zdjec-do-zewnetrznego-modelu.md
GEMINI_API_KEY=

# Model uzywany do opisow. Puste = gemini-3.5-flash-lite.
# Czytane w czasie startu kontenera, wiec zmiana modelu nie wymaga przebudowy obrazu.
GEMINI_MODEL=
